# Copie para .env e ajuste. Nunca versione o .env real.
PORT=3000

# SQL Server (login SQL; Windows Authentication não é suportada pelo driver)
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=TroqueEstaSenha!123
DB_NAME=MyCoffee
# Azure SQL: DB_ENCRYPT=true e DB_TRUST_SERVER_CERTIFICATE=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# false quando o banco já foi criado pelo provedor (ex.: Azure SQL)
DB_CRIAR_BANCO=true

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1d

# Regras do checkout
TAXA_ENTREGA=3.50
PREVISAO_MIN_MINUTOS=20
PREVISAO_MAX_MINUTOS=30

# Origens liberadas no CORS, separadas por vírgula (vazio = todas)
CORS_ORIGIN=

# Senha aplicada pelo "npm run db:setup" aos usuários de exemplo do script SQL
# (admin@mycoffee.com, barista@mycoffee.com, cliente@email.com). Só para desenvolvimento.
SEED_SENHA_PADRAO=MyCoffee@2026
